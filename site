<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>fifthdegree — Seek Connection</title>
    <meta
      name="description"
      content="fifthdegree.xyz — a different kind of connection. Seek Connection."
    />
    <meta name="theme-color" content="#ece8e1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --paper: #ece8e1;
        --paper-hot: #e4dfd6;
        --ink: #0d0c0b;
        --ink-soft: rgba(13, 12, 11, 0.58);
        --line: #a31835;
        --line-faint: rgba(163, 24, 53, 0.35);
        --accent: #0d0c0b;
        --rule: rgba(13, 12, 11, 0.12);
        --max: 68rem;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: "IBM Plex Sans", system-ui, sans-serif;
        font-size: 1.05rem;
        line-height: 1.55;
        color: var(--ink);
        background: var(--paper);
        overflow-x: hidden;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
      }

      /* —— Background: grid + SVG network —— */
      .field {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-color: var(--paper);
        background-image:
          linear-gradient(var(--rule) 1px, transparent 1px),
          linear-gradient(90deg, var(--rule) 1px, transparent 1px);
        background-size: 100% 11vmin, 11vmin 100%;
        background-position: -1px -1px;
      }

      .field__noise {
        position: absolute;
        inset: 0;
        opacity: 0.04;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      }

      .field svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .field .net {
        stroke: var(--line);
        stroke-width: 0.35;
        fill: none;
        opacity: 0.55;
      }

      .field .node {
        fill: var(--ink);
      }

      /* Giant watermark SC */
      .field__sc {
        position: absolute;
        font-family: "Fraunces", Georgia, serif;
        font-weight: 600;
        font-size: min(55vw, 42rem);
        line-height: 0.85;
        letter-spacing: -0.06em;
        color: rgba(13, 12, 11, 0.035);
        left: -2%;
        top: 8%;
        transform: rotate(-90deg);
        transform-origin: 0 0;
        white-space: nowrap;
        user-select: none;
      }

      /* —— Layout shell —— */
      .shell {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .wrap {
        width: min(100% - 2.5rem, var(--max));
        margin-inline: auto;
      }

      /* —— Header —— */
      .head {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem 0;
        border-bottom: 1px solid var(--rule);
      }

      .mark {
        justify-self: start;
        display: flex;
        align-items: baseline;
        gap: 0.35rem;
        text-decoration: none;
        color: inherit;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: -0.02em;
      }

      .mark__deg {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--line);
        border: 1px solid var(--line-faint);
        padding: 0.15rem 0.4rem;
      }

      .mark__name {
        text-transform: lowercase;
      }

      .mark__name::before {
        content: "S";
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.65rem;
        opacity: 0.2;
        margin-right: 0.05em;
        vertical-align: super;
      }

      .mark__name::after {
        content: "C";
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.65rem;
        opacity: 0.2;
        margin-left: 0.02em;
        vertical-align: super;
      }

      .head__nav {
        justify-self: center;
        display: flex;
        gap: 1.75rem;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
      }

      .head__nav a {
        color: var(--ink-soft);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: color 0.15s, border-color 0.15s;
      }

      .head__nav a:hover {
        color: var(--ink);
        border-bottom-color: var(--line);
      }

      .head__sig {
        justify-self: end;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.68rem;
        letter-spacing: 0.4em;
        color: var(--ink-soft);
      }

      /* —— Hero —— */
      .hero {
        padding: clamp(3.5rem, 12vh, 7rem) 0 clamp(4rem, 14vh, 8rem);
        display: grid;
        gap: clamp(2rem, 5vw, 3.5rem);
      }

      @media (min-width: 860px) {
        .hero {
          grid-template-columns: minmax(0, 1fr) minmax(0, 14rem);
          align-items: end;
        }
      }

      .hero__main {
        max-width: 40rem;
      }

      .hero__kicker {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.72rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--line);
        margin: 0 0 1.25rem;
      }

      .hero__kicker-text {
        letter-spacing: inherit;
      }

      .hero__kicker-site {
        color: var(--ink);
        opacity: 0.35;
      }

      .hero__pulse-wrap {
        position: relative;
        flex-shrink: 0;
        width: 12px;
        height: 12px;
        align-self: center;
      }

      .hero__pulse-ring {
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 2px solid #d4a800;
        opacity: 0.65;
        animation: hero-pulse-ring 1.75s ease-out infinite;
      }

      .hero__pulse-dot {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: #f5d000;
        box-shadow:
          0 0 0 1px rgba(212, 168, 0, 0.5),
          0 0 12px 2px rgba(245, 208, 0, 0.55),
          0 0 24px 4px rgba(245, 208, 0, 0.2);
        animation: hero-pulse-dot 1.75s ease-in-out infinite;
      }

      @keyframes hero-pulse-ring {
        0% {
          transform: scale(0.45);
          opacity: 0.85;
        }
        100% {
          transform: scale(2.4);
          opacity: 0;
        }
      }

      @keyframes hero-pulse-dot {
        0%,
        100% {
          transform: scale(1);
          filter: brightness(1);
        }
        50% {
          transform: scale(0.88);
          filter: brightness(1.15);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hero__pulse-ring {
          animation: none;
          opacity: 0;
        }

        .hero__pulse-dot {
          animation: none;
        }
      }

      .hero h1 {
        font-family: "Fraunces", Georgia, serif;
        font-weight: 400;
        font-size: clamp(2.35rem, 6.5vw, 3.85rem);
        line-height: 1.08;
        letter-spacing: -0.03em;
        margin: 0 0 1.5rem;
      }

      .hero h1 em {
        font-style: italic;
        font-weight: 400;
      }

      .hero__lead {
        margin: 0;
        color: var(--ink-soft);
        max-width: 34rem;
        font-size: 1.08rem;
      }

      .hero__aside {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.72rem;
        line-height: 1.65;
        color: var(--ink-soft);
        border-left: 2px solid var(--line);
        padding-left: 1.25rem;
        align-self: end;
      }

      .hero__aside strong {
        display: block;
        font-weight: 500;
        color: var(--ink);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
      }

      /* Motto block */
      .motto-bar {
        margin-top: 2.75rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 2rem;
        padding: 1rem 0;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
      }

      .motto-bar__text {
        font-family: "Fraunces", Georgia, serif;
        font-size: clamp(1.35rem, 3vw, 1.85rem);
        letter-spacing: 0.02em;
        margin: 0;
      }

      .motto-bar__text .s {
        color: var(--line);
        font-style: italic;
      }

      .motto-bar__text .c {
        border-bottom: 2px solid var(--line);
      }

      .motto-bar__mono {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.68rem;
        letter-spacing: 0.35em;
        color: var(--ink-soft);
        margin: 0;
      }

      /* —— Strip —— */
      .strip {
        background: var(--ink);
        color: var(--paper);
        padding: 2.5rem 0;
        position: relative;
        overflow: hidden;
      }

      .strip::before {
        content: "SC";
        position: absolute;
        right: 4%;
        top: 50%;
        transform: translateY(-50%);
        font-family: "IBM Plex Mono", monospace;
        font-size: clamp(4rem, 18vw, 12rem);
        font-weight: 500;
        letter-spacing: -0.05em;
        opacity: 0.07;
        pointer-events: none;
      }

      .strip .wrap {
        display: grid;
        gap: 1.5rem;
      }

      @media (min-width: 720px) {
        .strip .wrap {
          grid-template-columns: 1fr 1fr;
          gap: 3rem;
        }
      }

      .strip p {
        margin: 0;
        font-size: 0.98rem;
        line-height: 1.6;
        opacity: 0.88;
      }

      .strip p strong {
        opacity: 1;
        font-weight: 600;
      }

      /* —— Panels —— */
      .panels {
        padding: clamp(3.5rem, 10vh, 6rem) 0;
      }

      .panels__grid {
        display: grid;
        gap: 1px;
        background: var(--rule);
        border: 1px solid var(--rule);
      }

      @media (min-width: 640px) {
        .panels__grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .panel {
        background: var(--paper);
        padding: 1.75rem 1.5rem;
        min-height: 11rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1rem;
      }

      .panel:nth-child(2) {
        background: var(--paper-hot);
      }

      .panel__label {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.65rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--line);
      }

      .panel h3 {
        font-family: "Fraunces", Georgia, serif;
        font-weight: 400;
        font-size: 1.35rem;
        margin: 0;
        line-height: 1.25;
      }

      .panel p {
        margin: 0;
        font-size: 0.88rem;
        color: var(--ink-soft);
        line-height: 1.5;
      }

      .panel--glyph .panel__big {
        font-family: "IBM Plex Mono", monospace;
        font-size: 3.5rem;
        font-weight: 500;
        color: var(--line);
        opacity: 0.25;
        line-height: 1;
      }

      /* —— CTA —— */
      .cta {
        padding: 0 0 4.5rem;
      }

      .cta__box {
        border: 1px solid var(--rule);
        padding: clamp(1.75rem, 4vw, 2.5rem);
        display: grid;
        gap: 1.5rem;
      }

      @media (min-width: 700px) {
        .cta__box {
          grid-template-columns: 1fr auto;
          align-items: end;
        }
      }

      .cta__copy h2 {
        font-family: "Fraunces", Georgia, serif;
        font-weight: 400;
        font-size: 1.65rem;
        margin: 0 0 0.5rem;
      }

      .cta__copy p {
        margin: 0;
        color: var(--ink-soft);
        font-size: 0.95rem;
        max-width: 28rem;
      }

      .cta__copy p abbr {
        text-decoration: none;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.85em;
        letter-spacing: 0.15em;
        color: var(--line);
      }

      .cta__form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        width: 100%;
        max-width: 22rem;
      }

      .cta__form input {
        flex: 1 1 10rem;
        min-width: 0;
        font: inherit;
        font-size: 0.9rem;
        padding: 0.75rem 1rem;
        border: 1px solid var(--rule);
        background: #fff;
        color: var(--ink);
      }

      .cta__form input:focus {
        outline: 2px solid var(--line);
        outline-offset: 0;
        border-color: transparent;
      }

      .cta__form button {
        font: inherit;
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        padding: 0.75rem 1.25rem;
        border: none;
        background: var(--ink);
        color: var(--paper);
        cursor: pointer;
        transition: background 0.15s, transform 0.15s;
      }

      .cta__form button:hover {
        background: var(--line);
      }

      .cta__form button:active {
        transform: scale(0.98);
      }

      /* —— Footer —— */
      .foot {
        margin-top: auto;
        padding: 1.5rem 0 2rem;
        border-top: 1px solid var(--rule);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        font-size: 0.8rem;
        color: var(--ink-soft);
      }

      .foot__sc {
        font-family: "IBM Plex Mono", monospace;
        letter-spacing: 0.5em;
        font-size: 0.65rem;
      }

      .foot__domain {
        font-family: "IBM Plex Mono", monospace;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </head>
  <body>
    <div class="field" aria-hidden="true">
      <div class="field__noise"></div>
      <span class="field__sc">SC</span>
      <svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <g class="net-lines"></g>
        <g class="net-nodes"></g>
      </svg>
    </div>

    <div class="shell">
      <header class="wrap head">
        <a class="mark" href="#top">
          <span class="mark__deg">5°</span>
          <span class="mark__name">fifthdegree</span>
        </a>
        <nav class="head__nav" aria-label="Primary">
          <a href="#idea">Idea</a>
          <a href="#layers">Layers</a>
          <a href="#signal">Signal</a>
        </nav>
        <p class="head__sig">S · C</p>
      </header>

      <main id="top">
        <section class="wrap hero">
          <div class="hero__main">
            <p
              class="hero__kicker"
              role="status"
              aria-live="polite"
              aria-label="Under construction"
            >
              <span class="hero__pulse-wrap" aria-hidden="true">
                <span class="hero__pulse-ring"></span>
                <span class="hero__pulse-dot"></span>
              </span>
              <span class="sr-only">Under construction.</span>
              <span class="hero__kicker-text">
                <span class="hero__kicker-site">fifthdegree.xyz</span> · not public yet
              </span>
            </p>
            <h1>
              Curiosity is the <em>protocol</em>.<br />
              Connection is the point.
            </h1>
            <p class="hero__lead">
              Fifthdegree is a work in progress: a space for people who want
              depth over volume — where <strong>seeking</strong> matters more
              than scrolling. Details stay scarce on purpose.
            </p>
            <div class="motto-bar">
              <p class="motto-bar__text">
                <span class="s">S</span>eek <span class="c">C</span>onnection
              </p>
              <p class="motto-bar__mono">INITIALS OPTIONAL</p>
            </div>
          </div>
          <aside class="hero__aside">
            <strong>Read me</strong>
            If you expected a product tour, this isn’t it. The fifth degree is
            a question posed in wire and type — <em>S</em>low <em>C</em>ircuits,
            same letters, different frame.
          </aside>
        </section>

        <section class="strip" id="idea" aria-labelledby="idea-h">
          <div class="wrap">
            <p id="idea-h">
              <strong>What is it?</strong> We’re building something that treats
              relationships as infrastructure — not as content to monetize.
              Anonymous until you choose not to be. Sparse by design.
            </p>
            <p>
              The name is a hint: five degrees of separation, or a fifth layer
              of intent — pick your reading. Both are allowed.
            </p>
          </div>
        </section>

        <section class="wrap panels" id="layers" aria-label="Three layers">
          <div class="panels__grid">
            <article class="panel" id="signal">
              <span class="panel__label">01 · Signal</span>
              <h3>Chosen traces</h3>
              <p>
                You decide what leaves a mark. Nothing invisible, nothing
                “accidentally” shared.
              </p>
            </article>
            <article class="panel panel--glyph">
              <span class="panel__label">02 · SC</span>
              <div class="panel__big" aria-hidden="true">S</div>
              <p>
                <strong>S</strong>eek: the active verb. The site keeps asking
                without shouting answers.
              </p>
            </article>
            <article class="panel panel--glyph">
              <span class="panel__label">03 · SC</span>
              <div class="panel__big" aria-hidden="true">C</div>
              <p>
                <strong>C</strong>onnection: not networking — contact with
                weight.
              </p>
            </article>
          </div>
        </section>

        <section class="wrap cta" id="signal-form">
          <div class="cta__box">
            <div class="cta__copy">
              <h2>Leave a line</h2>
              <p>
                No list, no launch date here — just a place to drop your email
                if you want a ping when the graph opens.
                <abbr title="Seek Connection">SC</abbr> will mean something
                concrete soon enough.
              </p>
            </div>
            <form class="cta__form" action="#" method="get" onsubmit="return false;">
              <label class="sr-only" for="email">Email</label>
              <input
                id="email"
                type="email"
                name="email"
                placeholder="you@domain"
                autocomplete="email"
              />
              <button type="submit">Notify me</button>
            </form>
          </div>
        </section>
      </main>

      <footer class="wrap foot">
        <span class="foot__sc" aria-hidden="true">S</span>
        <p class="foot__domain">© <span id="y"></span> fifthdegree.xyz</p>
        <span class="foot__sc" aria-hidden="true">C</span>
      </footer>
    </div>

    <script>
      (function () {
        var y = document.getElementById("y");
        if (y) y.textContent = String(new Date().getFullYear());

        var linesG = document.querySelector(".net-lines");
        var nodesG = document.querySelector(".net-nodes");
        if (!linesG || !nodesG) return;

        var NS = "http://www.w3.org/2000/svg";

        function line(x1, y1, x2, y2) {
          var el = document.createElementNS(NS, "line");
          el.setAttribute("class", "net");
          el.setAttribute("x1", x1);
          el.setAttribute("y1", y1);
          el.setAttribute("x2", x2);
          el.setAttribute("y2", y2);
          linesG.appendChild(el);
        }

        function node(cx, cy) {
          var c = document.createElementNS(NS, "circle");
          c.setAttribute("class", "node");
          c.setAttribute("cx", cx);
          c.setAttribute("cy", cy);
          c.setAttribute("r", 0.55);
          nodesG.appendChild(c);
        }

        var pts = [
          [12, 88],
          [28, 52],
          [44, 72],
          [58, 38],
          [72, 62],
          [88, 22],
          [22, 28],
          [78, 88],
          [38, 18],
          [92, 55],
        ];

        for (var i = 0; i < pts.length; i++) {
          node(pts[i][0], pts[i][1]);
        }

        var links = [
          [0, 1],
          [1, 2],
          [2, 3],
          [3, 4],
          [4, 5],
          [1, 6],
          [6, 8],
          [4, 7],
          [3, 9],
          [0, 7],
          [2, 9],
        ];

        for (var j = 0; j < links.length; j++) {
          var a = pts[links[j][0]];
          var b = pts[links[j][1]];
          line(a[0], a[1], b[0], b[1]);
        }

        line(0, 45, 100, 62);
        line(55, 100, 48, 0);

        var prefersReduced =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (!prefersReduced) {
          var shift = 0;
          function tick() {
            shift = (shift + 0.015) % (Math.PI * 2);
            var dx = Math.sin(shift) * 0.8;
            var dy = Math.cos(shift * 0.7) * 0.6;
            linesG.setAttribute(
              "transform",
              "translate(" + dx + " " + dy + ")"
            );
            requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
        }
      })();
    </script>
  </body>
</html>
